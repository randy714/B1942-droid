<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gdroid_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B1942-DROID"
            android:textColor="@color/gdroid_text_main"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATTLEFIELD 1942  //  MOBILE ENGINE"
            android:textColor="@color/gdroid_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#34C759"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine Standalone Ready"
                android:textColor="@color/gdroid_text_main" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="@color/gdroid_cyan"
            android:text="PLAY BATTLEFIELD 1942"
            android:textColor="#0D0B0A"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="■ SETTINGS &amp; TOOLS"
            android:textColor="@color/gdroid_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnSelectFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Play from a folder\nSelect BF1942 PC directory"
                android:textColor="@color/gdroid_text_main" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gdroid_card_stroke" />

            <TextView
                android:id="@+id/btnControlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Control layout editor\nMove and resize touch buttons"
                android:textColor="@color/gdroid_text_main" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
