<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gdroid_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B1942-DROID"
            android:textColor="@color/gdroid_text_main"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATTLEFIELD 1942  //  FLATSCREEN RUNTIME"
            android:textColor="@color/gdroid_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#34C759"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to play (Battlefield 1942)"
                android:textColor="@color/gdroid_text_main"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Big Play Button -->
        <Button
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="@color/gdroid_cyan"
            android:text="PLAY BATTLEFIELD 1942"
            android:textColor="#0D0B0A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Sub Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnPlayMap"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:text="PLAY A MAP..."
                android:textColor="@color/gdroid_text_main"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnLanMultiplayer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:text="LAN MULTIPLAYER"
                android:textColor="@color/gdroid_text_main"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Section: DOWNLOADS & MODS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="■ DOWNLOADS &amp; MODS"
            android:textColor="@color/gdroid_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/btnModManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Mod Manager\nSelect and activate installed B1942 mods"
                android:textColor="@color/gdroid_text_main" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gdroid_card_stroke" />

            <TextView
                android:id="@+id/btnLaunchMod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Launch a Mod...\nDirect boot into Desert Combat or Custom Mods"
                android:textColor="@color/gdroid_text_main" />
        </LinearLayout>

        <!-- Section: LOCAL GAME FILES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="■ LOCAL GAME FILES"
            android:textColor="@color/gdroid_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/btnSelectFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Play from a folder\nSelect BF1942 directory containing BF1942.exe &amp; Mods"
                android:textColor="@color/gdroid_text_main" />
        </LinearLayout>

        <!-- Section: SETTINGS & TOOLS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="■ SETTINGS &amp; TOOLS"
            android:textColor="@color/gdroid_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnDisplayControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Display &amp; Performance Settings\nAdjust Resolution, FPS Limit, Memory Pool &amp; Renderer"
                android:textColor="@color/gdroid_text_main" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gdroid_card_stroke" />

            <TextView
                android:id="@+id/btnControlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Control layout editor\nPreview touch controls and adjust positions, sizes &amp; opacity"
                android:textColor="@color/gdroid_text_main" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gdroid_card_stroke" />

            <TextView
                android:id="@+id/btnProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Profile\nPlayer Name: COMMANDER"
                android:textColor="@color/gdroid_text_main" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B1942-DROID  ·  v2.5"
            android:textColor="@color/gdroid_text_sub"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
