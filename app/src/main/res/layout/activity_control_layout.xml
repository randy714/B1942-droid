<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gdroid_bg">

    <FrameLayout
        android:id="@+id/layoutEditorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#DD1E1612"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnResetLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="RESET"
            android:textColor="@color/gdroid_text_main"
            android:backgroundTint="@color/gdroid_card"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSaveLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SAVE LAYOUT"
            android:textColor="#0D0B0A"
            android:backgroundTint="@color/gdroid_cyan"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</RelativeLayout>
