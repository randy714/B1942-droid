<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/b1942_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCurrentPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:textColor="@color/b1942_gold"
        android:text="/sdcard/B1942-droid/game" />

    <ListView
        android:id="@+id/fileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSelectCurrentFolder"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SELECT THIS FOLDER"
        android:backgroundTint="@color/b1942_accent"
        android:textColor="@color/b1942_bg" />
</LinearLayout>
