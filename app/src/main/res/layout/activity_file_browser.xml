<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gdroid_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCurrentPath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/storage/emulated/0/"
        android:textColor="@color/gdroid_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/fileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnSelectCurrentFolder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/gdroid_cyan"
        android:text="USE THIS GAME FOLDER"
        android:textColor="#0D0B0A"
        android:textStyle="bold" />
</LinearLayout>
